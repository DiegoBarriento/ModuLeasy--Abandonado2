{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0",
            "includeFiles": "classes/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}