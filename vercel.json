{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "includeFiles": "**/*.php"
        }
    },
    "rewrites": [
        {
            "source": "/api/:endpoint",
            "destination": "/api/index.php?endpoint=:endpoint"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}