{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "services": {
        "api": {
        "entrypoint": "api/Dockerfile.vercel"
        },
        "web": {
        "entrypoint": "web/Dockerfile.vercel"
        }
    },
    "rewrites": [
        {"source": "/(.*)", "destination": "/index.html"},
        { "source": "/api/(.*)", "destination": "api" },
        { "source": "/(.*)", "destination": "web" }
    ]
}